{
  "include": ["src/**/*"],
  "compilerOptions": {
    /* Language and Environment */
    "target": "es2024",
    "types": ["node"],

    /* Modules */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "resolveJsonModule": true,

    /* Emit */
    "outDir": "./dist",
    "sourceMap": true,

    /* Interop Constraints */
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,

    /* Completeness */
    "skipLibCheck": true
  }
}
