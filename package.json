{
	"name": "rest-api-ts",
	"version": "1.0.0",
	"description": "",
	"main": "dist/bin/www.js",
	"engines": {
		"node": "^22.18.0 || >=24.11.0"
	},
	"scripts": {
		"start": "npm run build && node ./dist/bin/www",
		"start:nodemon": "nodemon ./dist/bin/www",
		"dev": "npm run db:generate && npm-run-all --parallel build:watch start:nodemon",
		"build": "npm run db:generate && tsc",
		"build:watch": "tsc --watch",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"pretest": "npm run db:generate",
		"test": "jest"
	},
	"jest": {
		"testEnvironment": "node",
		"setupFiles": [
			"dotenv/config"
		],
		"transform": {
			"^.+\\.[tj]sx?$": "babel-jest"
		}
	},
	"keywords": [],
	"author": "hrndbrs",
	"license": "ISC",
	"dependencies": {
		"@prisma/adapter-mariadb": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"bcrypt": "^6.0.0",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"winston": "^3.19.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@babel/core": "^8.0.5",
		"@babel/preset-env": "^8.0.5",
		"@babel/preset-typescript": "^8.0.1",
		"@jest/globals": "^30.5.1",
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.13.4",
		"@types/supertest": "^7.2.1",
		"babel-jest": "^30.5.1",
		"jest": "^30.5.1",
		"nodemon": "^3.1.14",
		"npm-run-all2": "^8.0.4",
		"prisma": "^7.10.0",
		"supertest": "^7.2.2",
		"typescript": "^7.0.2"
	}
}
